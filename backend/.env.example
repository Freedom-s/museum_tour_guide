# ==================== Backend Environment Configuration ====================

# 应用配置
APP_NAME=Museum Tour Guide Backend
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=5000

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=museum
DB_PASSWORD=123456
DB_NAME=museum

# MinIO 配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_DOCS=artifacts
MINIO_BUCKET_IMAGES=uploads

# Embedding 服务配置
EMBEDDING_SERVICE_URL=http://localhost:8000

# 上传配置
MAX_UPLOAD_SIZE=52428800
BASE_URL=http://localhost:5000
